APP_NAME=Patungan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=patungan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=patungan@trackertask.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="patungan@trackertask.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Patungan payment gateway ---
# Driver: midtrans (real QRIS) | sandbox (local dev simulator, non-production)
# sandbox (local simulator) | doku | midtrans
PAYMENT_GATEWAY=sandbox
PAYMENT_INVOICE_TTL=900

# DOKU SNAP Direct API (QRIS). Fill these in from the DOKU dashboard.
# Never commit a real secret or key file - both are ignored by git.
DOKU_ENV=sandbox
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_CLIENT_ID=
DOKU_CLIENT_SECRET=
DOKU_MERCHANT_ID=
DOKU_TERMINAL_ID=PTGN01
DOKU_CHANNEL_ID=H2H

# Our RSA key pair; the public half is uploaded to DOKU.
DOKU_PRIVATE_KEY_PATH=storage/app/doku/private.pem
DOKU_PUBLIC_KEY_PATH=storage/app/doku/public.pem
# DOKU's own public key, used to verify the notifications they send us.
DOKU_DOKU_PUBLIC_KEY_PATH=storage/app/doku/doku-public.pem

# Must match the notification URL registered in the DOKU dashboard exactly:
# its path is part of the signed string.
DOKU_PAYMENT_NOTIFICATION_URL=https://your-domain.test/webhooks/payments/doku

# Both need DOKU to switch the service on for the merchant first.
DOKU_ENABLE_SPLIT_SETTLEMENT=false
DOKU_ENABLE_PAYOUT=false

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_PRODUCTION=false

# --- Fees (integer rupiah / basis points) ---
PATUNGAN_FEE_BEARER=organizer
PLATFORM_FEE_FLAT=250
PLATFORM_FEE_BPS=0
GATEWAY_FEE_FLAT=0
GATEWAY_FEE_BPS=70

# --- Payout ---
PAYOUT_PROVIDER=manual
PAYOUT_MIN_AMOUNT=10000

# --- Login dengan Google (isi setelah bikin OAuth client di Google Cloud) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
