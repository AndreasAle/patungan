APP_NAME=Patungan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=patungan
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=patungan@trackertask.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="patungan@trackertask.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Patungan payment gateway ---
# Driver: dana | doku | midtrans (real QRIS) | sandbox (local simulator only)
PAYMENT_GATEWAY=sandbox
PAYMENT_INVOICE_TTL=900

# DANA SNAP QRIS MPM (Acquirer). Sandbox credentials come from
# https://dashboard.dana.id/sandbox/ ; production keys are generated by you and
# the public half is uploaded through the merchant portal.
# Never commit a real key - the whole storage/app/dana directory is git-ignored.
DANA_ENV=sandbox
# No default: DANA issues the sandbox host together with the credentials.
DANA_BASE_URL=
# DANA calls this the Client ID. It is sent as X-PARTNER-ID.
DANA_PARTNER_ID=
DANA_MERCHANT_ID=
# Required by Generate QRIS. Keep this merchant-side shop identifier stable.
DANA_STORE_ID=
# Only if DANA has registered a division for you.
DANA_SUB_MERCHANT_ID=
DANA_CHANNEL_ID=95221
# Sent as the ORIGIN header; DANA matches it against the registered domain.
DANA_ORIGIN=your-domain.test

# Our RSA private key. The matching public key is uploaded to DANA.
#   openssl genrsa -out private_key.pem 2048
#   openssl rsa -in private_key.pem -out public_key.pem -pubout
DANA_PRIVATE_KEY_PATH=storage/app/dana/private.pem
# DANA's own public key. Without it every notification is refused, because
# there is no other way to tell a real settlement from a forged one.
DANA_DANA_PUBLIC_KEY_PATH=storage/app/dana/dana-public.pem

# Must match the Finish Notify URL registered with DANA exactly: its path is
# part of the string they sign.
DANA_NOTIFICATION_URL=https://your-domain.test/v1.0/debit/notify
# Enable only while running DANA's sandbox "Internal Server Error" Finish Notify scenario.
DANA_UAT_FORCE_NOTIFY_ERROR=false

# DOKU SNAP Direct API (QRIS). Fill these in from the DOKU dashboard.
# Never commit a real secret or key file - both are ignored by git.
DOKU_ENV=sandbox
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_CLIENT_ID=
DOKU_CLIENT_SECRET=
DOKU_MERCHANT_ID=
DOKU_TERMINAL_ID=PTGN01
DOKU_CHANNEL_ID=H2H

# Our RSA key pair; the public half is uploaded to DOKU.
DOKU_PRIVATE_KEY_PATH=storage/app/doku/private.pem
DOKU_PUBLIC_KEY_PATH=storage/app/doku/public.pem
# DOKU's own public key, used to verify the notifications they send us.
DOKU_DOKU_PUBLIC_KEY_PATH=storage/app/doku/doku-public.pem

# Must match the notification URL registered in the DOKU dashboard exactly:
# its path is part of the signed string.
DOKU_PAYMENT_NOTIFICATION_URL=https://your-domain.test/webhooks/payments/doku

# Both need DOKU to switch the service on for the merchant first.
DOKU_ENABLE_SPLIT_SETTLEMENT=false
DOKU_ENABLE_PAYOUT=false

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_PRODUCTION=false

# --- Fees (integer rupiah / basis points) ---
PATUNGAN_FEE_BEARER=payer
PLATFORM_FEE_FLAT=250
PLATFORM_FEE_BPS=0
GATEWAY_FEE_FLAT=0
GATEWAY_FEE_BPS=70

# --- Payout ---
PAYOUT_PROVIDER=manual
# Who can tell us the name on a bank account: none | dana
# DANA account inquiry lives in their Disbursement product, which is activated
# and UAT-tested separately from QRIS. Leave this at none until that is done -
# a verify button that fails every time is worse than no verify button.
PAYOUT_INQUIRY=none
PAYOUT_MIN_AMOUNT=10000

# --- Login dengan Google (isi setelah bikin OAuth client di Google Cloud) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
